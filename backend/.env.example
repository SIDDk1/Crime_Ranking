# Local MongoDB (development fallback)
# MONGO_URI=mongodb://localhost:27017/?serverSelectionTimeoutMS=2000

# MongoDB Atlas Cloud
# Replace USERNAME, PASSWORD and CLUSTER-NAME with your Atlas values.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER-NAME.mongodb.net/CrimeRankingDB?retryWrites=true&w=majority&appName=CrimeRanking
MONGO_DB_NAME=CrimeRankingDB

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
